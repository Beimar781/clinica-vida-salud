APP_NAME="Clínica Vida Salud"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=clinica_vida_salud
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="citas@clinicavidasalud.test"
MAIL_FROM_NAME="${APP_NAME}"

# Recuperar contraseña: en local deja MAIL_MAILER=log y el enlace queda en storage/logs/laravel.log
# (línea «ENLACE DE RECUPERACION»). En producción (Railway bloquea el SMTP) el correo sale por la API de Brevo:
# MAIL_MAILER=brevo, BREVO_API_KEY=<clave de Brevo> y MAIL_FROM_ADDRESS = el remitente verificado en Brevo.
BREVO_API_KEY=

# Administrador inicial (lo crea el seeder). Ambas variables son opcionales: sin ADMIN_PASSWORD el administrador
# usa la contraseña de demostración Demo1234* (igual que las demás cuentas de demostración) y sin ADMIN_CORREO
# usa admin@vidasalud.test. En un despliegue real defina las dos.
ADMIN_PASSWORD=
# ADMIN_CORREO=admin@vidasalud.test

# Datos de demostración (usuarios, médicos con horarios, pacientes y citas). Por defecto: sí en local y no en
# producción. En Railway se activa con SEMBRAR_DEMO=true para la presentación y después se pone en false.
# SEMBRAR_DEMO=true

# Pago con tarjeta (CU-09 y CU-11): Stripe Checkout alojado, en modo de prueba. STRIPE_SECRET es la clave secreta
# de prueba (sk_test_...) de https://dashboard.stripe.com/test/apikeys; sin ella el pago con tarjeta no está
# disponible y el efectivo sigue funcionando. Los montos están en bolivianos: con STRIPE_MONEDA=bob y TIPO_CAMBIO=1
# se envían tal cual; si la cuenta rechazara BOB use STRIPE_MONEDA=usd y TIPO_CAMBIO=6.96.
STRIPE_SECRET=
STRIPE_MONEDA=bob
TIPO_CAMBIO=1

# Resumen con IA de los reportes (CU-18): Google Gemini. Sin clave el reporte se muestra sin resumen.
# Clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
IA_MODELO=gemini-3.5-flash-lite
