APP_NAME="Clínica Vida Salud"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=clinica_vida_salud
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="citas@clinicavidasalud.test"
MAIL_FROM_NAME="${APP_NAME}"

# Recuperar contraseña: en local deja MAIL_MAILER=log y el enlace queda en storage/logs/laravel.log
# (línea «ENLACE DE RECUPERACION»). En producción (Railway bloquea el SMTP) el correo sale por la API de Brevo:
# MAIL_MAILER=brevo, BREVO_API_KEY=<clave de Brevo> y MAIL_FROM_ADDRESS = el remitente verificado en Brevo.
BREVO_API_KEY=

# Administrador inicial (lo crea el seeder): contraseña obligatoria; el correo es opcional
# (por defecto admin@vidasalud.test; en un despliegue real use uno al que tenga acceso).
ADMIN_PASSWORD=
# ADMIN_CORREO=admin@vidasalud.test

# Datos de demostración (usuarios, médicos con horarios, pacientes y citas). Por defecto: sí en local y no en
# producción. En Railway se activa con SEMBRAR_DEMO=true para la presentación y después se pone en false.
# SEMBRAR_DEMO=true
